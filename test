name: APK derle

on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Kodu al
        uses: actions/checkout@v4

      - name: Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      # NOT: android-actions/setup-android eylemi şu an eski/kaldırılmış
      # bir "tools" paketini kurmaya çalıştığı için hata veriyor. Buna
      # gerek yok: GitHub'ın ubuntu-latest çalıştırıcılarında Android SDK
      # zaten hazır kurulu gelir (ANDROID_HOME ayarlı). Sadece lisansları
      # kabul etmek yeterli.
      - name: SDK lisanslarını kabul et
        run: yes | $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses || true

      - name: Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: APK ve AAB derle (debug)
        run: gradle assembleDebug bundleDebug --no-daemon --stacktrace

      - name: Dosyaları adlandır
        run: |
          V=$(tr -d '[:space:]' < VERSION)
          mkdir -p cikti
          cp app/build/outputs/apk/debug/app-debug.apk "cikti/PublicStats-$V.apk"
          cp app/build/outputs/bundle/debug/app-debug.aab "cikti/PublicStats-$V.aab"

      - name: APK'yı yükle
        uses: actions/upload-artifact@v4
        with:
          name: PublicStats-APK
          path: cikti/*.apk

      - name: AAB'yi yükle
        uses: actions/upload-artifact@v4
        with:
          name: PublicStats-AAB
          path: cikti/*.aab
